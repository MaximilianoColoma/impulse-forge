# Synapse / Stripe config template
# Never commit real sk_live/sk_test or whsec_ values or real price/account IDs.
# Copy to supabase/.env on the deployment host and fill real values there.
STRIPE_SECRET_KEY=sk_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_after_creating_the_new_webhook
STRIPE_EXPECTED_ACCOUNT_ID=acct_replace_with_expected_account_id
STRIPE_EXPECT_LIVEMODE=false

STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_YEARLY=price_replace_me
STRIPE_PRICE_POWER_MONTHLY=price_replace_me
STRIPE_PRICE_POWER_YEARLY=price_replace_me
STRIPE_PRICE_ENTERPRISE_SEAT_MONTHLY=price_replace_me
STRIPE_PRICE_ENTERPRISE_SEAT_YEARLY=price_replace_me

# Optional. customer-portal creates or reuses a configuration when omitted.
STRIPE_PORTAL_CONFIG_ID=
BILLING_ENABLED=false
