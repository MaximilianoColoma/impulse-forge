# Synapse — production build env template.
# Copy this to /opt/synapse/.env on the VPS and fill in the real values.
# NEVER commit this file; it carries a live publishable key.
#
# VITE_* are baked into the static bundle at BUILD time (the Vite SPA),
# read by deploy/deploy-build.sh / docker-deploy.sh from this file.
# The edge functions (Stripe checkout/webhook) read their own STRIPE_* env
# from the Supabase Edge Function config, not from here.
#
# Real prod Supabase project: edgpqsjqlrnuqwikfwjh

# Runtime app environment used to pick allowed project refs.
VITE_APP_ENV=production

# The production Supabase project URL + publishable (anon) key.
VITE_SUPABASE_URL=https://edgpqsjqlrnuqwikfwjh.supabase.co
VITE_SUPABASE_PROJECT_ID=edgpqsjqlrnuqwikfwjh
VITE_SUPABASE_PUBLISHABLE_KEY=your-real-publishable-key

# Enables the Stripe billing UI and checkout path in the app.
VITE_BILLING_ENABLED=true
