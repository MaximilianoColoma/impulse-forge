# Production must receive its own backend values from the production host.
# Real project id/url are configured on the deployment host, never committed.
VITE_APP_ENV=production
VITE_SUPABASE_PROJECT_ID=your-production-project-ref
VITE_SUPABASE_URL=https://your-production-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=configure-in-production-host
VITE_BILLING_ENABLED=false
